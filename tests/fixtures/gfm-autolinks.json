{
  "upstream": "github/cmark-gfm@0.29.0.gfm.13",
  "cases": [
    {
      "id": "internal-parens-www",
      "source": "www.google.com/search?q=(business))+ok\n",
      "expected": "<p><a href=\"http://www.google.com/search?q=(business))+ok\">www.google.com/search?q=(business))+ok</a></p>\n"
    },
    {
      "id": "internal-parens-http",
      "source": "http://example.com/search?q=(word))+end\n",
      "expected": "<p><a href=\"http://example.com/search?q=(word))+end\">http://example.com/search?q=(word))+end</a></p>\n"
    },
    {
      "id": "internal-parens-https",
      "source": "https://example.com/search?q=(word))+end\n",
      "expected": "<p><a href=\"https://example.com/search?q=(word))+end\">https://example.com/search?q=(word))+end</a></p>\n"
    },
    {
      "id": "internal-parens-ftp",
      "source": "ftp://example.com/search?q=(word))+end\n",
      "expected": "<p><a href=\"ftp://example.com/search?q=(word))+end\">ftp://example.com/search?q=(word))+end</a></p>\n"
    },
    {
      "id": "trailing-parens",
      "source": "(www.example.com/a(b)))\n",
      "expected": "<p>(<a href=\"http://www.example.com/a(b)\">www.example.com/a(b)</a>))</p>\n"
    },
    {
      "id": "nested-parens",
      "source": "www.example.com/a((b))\n",
      "expected": "<p><a href=\"http://www.example.com/a((b))\">www.example.com/a((b))</a></p>\n"
    },
    {
      "id": "punctuation-after-parens",
      "source": "www.example.com/a(b))).\n",
      "expected": "<p><a href=\"http://www.example.com/a(b)\">www.example.com/a(b)</a>)).</p>\n"
    },
    {
      "id": "trailing-entity-www",
      "source": "www.example.com/search?q=word&hl;\n",
      "expected": "<p><a href=\"http://www.example.com/search?q=word\">www.example.com/search?q=word</a>&amp;hl;</p>\n"
    },
    {
      "id": "trailing-entity-http",
      "source": "http://example.com/search?q=word&hl;\n",
      "expected": "<p><a href=\"http://example.com/search?q=word\">http://example.com/search?q=word</a>&amp;hl;</p>\n"
    },
    {
      "id": "trailing-entity-https",
      "source": "https://example.com/search?q=word&hl;\n",
      "expected": "<p><a href=\"https://example.com/search?q=word\">https://example.com/search?q=word</a>&amp;hl;</p>\n"
    },
    {
      "id": "trailing-entity-ftp",
      "source": "ftp://example.com/search?q=word&hl;\n",
      "expected": "<p><a href=\"ftp://example.com/search?q=word\">ftp://example.com/search?q=word</a>&amp;hl;</p>\n"
    },
    {
      "id": "internal-entity",
      "source": "www.example.com/a&hl;next\n",
      "expected": "<p><a href=\"http://www.example.com/a&amp;hl;next\">www.example.com/a&amp;hl;next</a></p>\n"
    },
    {
      "id": "known-entity",
      "source": "www.example.com/a&copy;\n",
      "expected": "<p><a href=\"http://www.example.com/a\">www.example.com/a</a>©</p>\n"
    },
    {
      "id": "query-parameter",
      "source": "www.example.com/search?q=word&hl=en\n",
      "expected": "<p><a href=\"http://www.example.com/search?q=word&amp;hl=en\">www.example.com/search?q=word&amp;hl=en</a></p>\n"
    },
    {
      "id": "bare-semicolon",
      "source": "www.example.com/a;\n",
      "expected": "<p><a href=\"http://www.example.com/a\">www.example.com/a</a>;</p>\n"
    },
    {
      "id": "punctuation-suffix",
      "source": "www.example.com/a?!.,:*_~\n",
      "expected": "<p><a href=\"http://www.example.com/a\">www.example.com/a</a>?!.,:*_~</p>\n"
    },
    {
      "id": "quotes",
      "source": "www.example.com/a'\"\n",
      "expected": "<p><a href=\"http://www.example.com/a\">www.example.com/a</a>'&quot;</p>\n"
    },
    {
      "id": "less-than",
      "source": "www.example.com/he<lp\n",
      "expected": "<p><a href=\"http://www.example.com/he\">www.example.com/he</a>&lt;lp</p>\n"
    },
    {
      "id": "plus-email-domain",
      "source": "hello@mail+xyz.example\n",
      "expected": "<p>hello@mail+xyz.example</p>\n"
    },
    {
      "id": "plus-email-local",
      "source": "hello+xyz@mail.example\n",
      "expected": "<p><a href=\"mailto:hello+xyz@mail.example\">hello+xyz@mail.example</a></p>\n"
    },
    {
      "id": "multiple-links",
      "source": "www.first.com www.second.com http://third.com test@fourth.com\n",
      "expected": "<p><a href=\"http://www.first.com\">www.first.com</a> <a href=\"http://www.second.com\">www.second.com</a> <a href=\"http://third.com\">http://third.com</a> <a href=\"mailto:test@fourth.com\">test@fourth.com</a></p>\n"
    },
    {
      "id": "no-empty-www",
      "source": "www.\n",
      "expected": "<p>www.</p>\n"
    },
    {
      "id": "code-literal",
      "source": "`www.example.com/a(b))+ok`\n\n```text\nhttp://example.com/a&hl;\n```\n",
      "expected": "<p><code>www.example.com/a(b))+ok</code></p>\n<pre><code class=\"language-text\">http://example.com/a&amp;hl;\n</code></pre>\n"
    },
    {
      "id": "explicit-link",
      "source": "[www.example.com/a(b))+ok](https://else.example)\n",
      "expected": "<p><a href=\"https://else.example\">www.example.com/a(b))+ok</a></p>\n"
    },
    {
      "id": "html-link",
      "source": "<a href=\"https://else.example\">www.example.com/a(b))+ok</a>\n",
      "expected": "<p><a href=\"https://else.example\">www.example.com/a(b))+ok</a></p>\n"
    },
    {
      "id": "angle-link",
      "source": "<http://example.com/a(b))+ok>\n",
      "expected": "<p><a href=\"http://example.com/a(b))+ok\">http://example.com/a(b))+ok</a></p>\n"
    },
    {
      "id": "entity-in-code",
      "source": "`www.example.com/a&copy;`\n",
      "expected": "<p><code>www.example.com/a&amp;copy;</code></p>\n"
    },
    {
      "id": "bracket-boundary",
      "source": "[www.foo.com]\n",
      "expected": "<p>[www.foo.com]</p>\n"
    },
    {
      "id": "early-domain-underscore",
      "source": "www._foo.bar.baz\n",
      "expected": "<p><a href=\"http://www._foo.bar.baz\">www._foo.bar.baz</a></p>\n"
    },
    {
      "id": "penultimate-domain-underscore",
      "source": "www.foo._bar.baz\n",
      "expected": "<p>www.foo._bar.baz</p>\n"
    },
    {
      "id": "last-domain-underscore",
      "source": "www.foo.bar._baz\n",
      "expected": "<p>www.foo.bar._baz</p>\n"
    },
    {
      "id": "uppercase-www",
      "source": "WWW.EXAMPLE.COM\n",
      "expected": "<p>WWW.EXAMPLE.COM</p>\n"
    },
    {
      "id": "numeric-email-ending",
      "source": "a@b.c1\n",
      "expected": "<p>a@b.c1</p>\n"
    },
    {
      "id": "email-domain-underscore",
      "source": "a@b.c_d\n",
      "expected": "<p><a href=\"mailto:a@b.c_d\">a@b.c_d</a></p>\n"
    },
    {
      "id": "email-prefix-before-plus",
      "source": "a@b.c+z\n",
      "expected": "<p><a href=\"mailto:a@b.c\">a@b.c</a>+z</p>\n"
    },
    {
      "id": "email-underscore-leading-domain",
      "source": "user@_team.example\n",
      "expected": "<p><a href=\"mailto:user@_team.example\">user@_team.example</a></p>\n"
    },
    {
      "id": "email-underscore-multiple-labels",
      "source": "first_last@dept.example_team.org\n",
      "expected": "<p><a href=\"mailto:first_last@dept.example_team.org\">first_last@dept.example_team.org</a></p>\n"
    },
    {
      "id": "email-underscore-plus-local",
      "source": "first.last+tag@team.example_test\n",
      "expected": "<p><a href=\"mailto:first.last+tag@team.example_test\">first.last+tag@team.example_test</a></p>\n"
    },
    {
      "id": "email-trailing-underscore",
      "source": "first@example.org_\n",
      "expected": "<p>first@example.org_</p>\n"
    },
    {
      "id": "email-trailing-hyphen",
      "source": "first@example.org-\n",
      "expected": "<p>first@example.org-</p>\n"
    },
    {
      "id": "email-no-domain-period",
      "source": "user@host\n",
      "expected": "<p>user@host</p>\n"
    },
    {
      "id": "email-trailing-period",
      "source": "first@example_team.org.\n",
      "expected": "<p><a href=\"mailto:first@example_team.org\">first@example_team.org</a>.</p>\n"
    },
    {
      "id": "email-prefix-multiple",
      "source": "first@dept.example+tail second@dept.example+next\n",
      "expected": "<p><a href=\"mailto:first@dept.example\">first@dept.example</a>+tail <a href=\"mailto:second@dept.example\">second@dept.example</a>+next</p>\n"
    },
    {
      "id": "email-prefix-with-underscore",
      "source": "first@example_team.org+tail\n",
      "expected": "<p><a href=\"mailto:first@example_team.org\">first@example_team.org</a>+tail</p>\n"
    },
    {
      "id": "email-multiple-at",
      "source": "one@two@three.example\n",
      "expected": "<p>one@<a href=\"mailto:two@three.example\">two@three.example</a></p>\n"
    },
    {
      "id": "email-after-slash",
      "source": "/a@b.c_d\n",
      "expected": "<p>/<a href=\"mailto:a@b.c_d\">a@b.c_d</a></p>\n"
    },
    {
      "id": "email-in-emphasis",
      "source": "**a@b.c_d** and *a@b.c+z*\n",
      "expected": "<p><strong><a href=\"mailto:a@b.c_d\">a@b.c_d</a></strong> and <em><a href=\"mailto:a@b.c\">a@b.c</a>+z</em></p>\n"
    },
    {
      "id": "email-code-context",
      "source": "`a@b.c_d` and `a@b.c+z`\n\n```text\na@b.c_d\n```\n",
      "expected": "<p><code>a@b.c_d</code> and <code>a@b.c+z</code></p>\n<pre><code class=\"language-text\">a@b.c_d\n</code></pre>\n"
    },
    {
      "id": "email-link-label",
      "source": "[a@b.c_d](https://example.com)\n",
      "expected": "<p><a href=\"https://example.com\">a@b.c_d</a></p>\n"
    },
    {
      "id": "email-explicit-mailto",
      "source": "[Contact](mailto:a@b.c_d)\n",
      "expected": "<p><a href=\"mailto:a@b.c_d\">Contact</a></p>\n"
    },
    {
      "id": "email-angle-context",
      "source": "<a@b.c_d>\n",
      "expected": "<p>&lt;<a href=\"mailto:a@b.c_d\">a@b.c_d</a>&gt;</p>\n"
    },
    {
      "id": "email-html-anchor",
      "source": "<a href=\"https://example.com\">a@b.c_d</a>\n",
      "expected": "<p><a href=\"https://example.com\"><a href=\"mailto:a@b.c_d\">a@b.c_d</a></a></p>\n"
    },
    {
      "id": "email-image-alt",
      "source": "![a@b.c_d](src/icon.svg)\n",
      "expected": "<p><img src=\"src/icon.svg\" alt=\"a@b.c_d\" /></p>\n"
    },
    {
      "id": "email-url-path",
      "source": "https://example.com/a@b.c_d\n",
      "expected": "<p><a href=\"https://example.com/a@b.c_d\">https://example.com/a@b.c_d</a></p>\n"
    },
    {
      "id": "email-url-query",
      "source": "www.example.com/?address=a@b.c_d\n",
      "expected": "<p><a href=\"http://www.example.com/?address=a@b.c_d\">www.example.com/?address=a@b.c_d</a></p>\n"
    },
    {
      "id": "email-mixed-order",
      "source": "a@b.c_d www.example.com second@team.example+suffix http://other.example\n",
      "expected": "<p><a href=\"mailto:a@b.c_d\">a@b.c_d</a> <a href=\"http://www.example.com\">www.example.com</a> <a href=\"mailto:second@team.example\">second@team.example</a>+suffix <a href=\"http://other.example\">http://other.example</a></p>\n"
    },
    {
      "id": "unicode-email-host",
      "source": "user@παράδειγμα.δοκιμή\n",
      "expected": "<p>user@παράδειγμα.δοκιμή</p>\n"
    }
  ],
  "knownDeviations": [
    {
      "id": "uppercase-www",
      "reason": "Sheets retains case-insensitive www recognition; this pinned native implementation only recognizes lowercase www."
    },
    {
      "id": "numeric-email-ending",
      "reason": "Sheets retains a numeric final email-domain character; this pinned native implementation leaves it unlinked."
    },
    {
      "id": "email-html-anchor",
      "reason": "Sheets preserves an existing raw HTML anchor instead of emitting the nested email link produced by this native version."
    },
    {
      "id": "unicode-email-host",
      "reason": "Sheets retains Unicode email-host recognition and IDNA normalization; this pinned native implementation leaves the address unlinked."
    }
  ]
}
