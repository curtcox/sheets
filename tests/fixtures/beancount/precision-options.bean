option "tolerance_multiplier" "1"
option "inferred_tolerance_default" "USD:0.02"
option "inferred_tolerance_default" "EUR:0.003"
option "inferred_tolerance_default" "*:0.0004"
2026-01-01 open Assets:Bank
2026-01-01 open Expenses:Food
2026-01-01 open Assets:Stock STOCK
2026-01-02 * "Commodity default"
  Expenses:Food 10 USD
  Assets:Bank -9.99 USD
2026-01-03 * "Second commodity default survives repeated options"
  Expenses:Food 1 EUR
  Assets:Bank -0.998 EUR
2026-01-04 * "Wildcard default for integer units"
  Assets:Stock 1 STOCK {1.0003 GBP}
  Assets:Bank -1 GBP
2026-01-05 * "Custom multiplier"
  Expenses:Food 1.0 USD
  Assets:Bank -0.91 USD
