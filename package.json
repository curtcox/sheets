    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "js-yaml": "5.5.0",
    "lz-string": "1.5.0",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-github-alerts": "1.0.1",
    "markdown-it-task-lists": "2.1.1",
    "mathjs": "15.2.0",
    "mermaid": "12.2.0",
    "orga": "5.0.0",
    "temml": "0.14.0"
  }
