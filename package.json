{
  "name": "sheets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Buildless, shareable calculation documents",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "gallery:covers": "node scripts/render-gallery.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/unit/*.test.js",
